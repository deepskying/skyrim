FormList Function Choose(FormList allPools, Int playerLevel) Global
    Int size = allPools.GetSize()
    If size <= 0
        Return None
    EndIf
    Int eligible = 0
    FormList selected = None
    Int i = 0
    While i < size
        FormList candidate = allPools.GetAt(i) as FormList
        If candidate != None && candidate.GetSize() > 0 && playerLevel >= MinimumLevel(candidate)
            eligible += 1
            If Utility.RandomInt(1, eligible) == 1
                selected = candidate
            EndIf
        EndIf
        i += 1
    EndWhile
    Return selected
EndFunction
